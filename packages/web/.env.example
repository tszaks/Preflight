# App
NEXT_PUBLIC_BASE_URL=http://localhost:5173

# Supabase. Required only for the self-hosted web workflow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI analysis. Required only for full AI-powered reports.
ANTHROPIC_API_KEY=your-anthropic-key

# Worker endpoint shared secret. Use a long random value.
WORKER_SECRET=replace-with-random-string

# Optional. 64 hex characters for App Store Connect private-key encryption.
ASC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
