{
  "name": "preflightlaunch",
  "version": "1.0.10",
  "type": "module",
  "description": "Preflight CLI - App Store Review Scanner from your terminal",
  "bin": {
    "preflight": "dist/index.js",
    "preflightlaunch": "dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tszaks/Preflight.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/tszaks/Preflight",
  "author": "Tyler Szakacs <tylerszakacs@gmail.com>",
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "preflight",
    "app-store",
    "ios",
    "review",
    "cli",
    "apple",
    "scanner"
  ],
  "license": "AGPL-3.0-only"
}
